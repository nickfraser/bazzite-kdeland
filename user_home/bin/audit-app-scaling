#!/usr/bin/env bash

set -u

section() {
  printf '\n\n===== %s =====\n' "$1"
}

run() {
  printf '\n$ %s\n' "$*"
  "$@" 2>&1 || true
}

section "GTK scaling settings"
run bash -lc 'gsettings get org.gnome.desktop.interface font-name'
run bash -lc 'gsettings get org.gnome.desktop.interface text-scaling-factor'
run bash -lc 'gsettings get org.gnome.desktop.interface scaling-factor'

section "RPM packages"
run bash -lc 'rpm -q firefox remmina'

section "Flatpak packages"
run bash -lc 'flatpak list | grep -Ei "firefox|remmina"'

section "Hyprland monitor scales"
run bash -lc 'hyprctl monitors'

section "Hyprland client details"
run bash -lc 'hyprctl clients | grep -B3 -A12 -Ei "class:.*(firefox|remmina)"'

section "Manual Firefox check"
printf '%s\n' \
  'Open Firefox and visit about:support, then look for:' \
  '  Window Protocol: wayland or xwayland' \
  'Include that value when you send the log back.'
