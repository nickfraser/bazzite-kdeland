#!/usr/bin/env bash

set -u

section() {
  printf '\n\n===== %s =====\n' "$1"
}

run() {
  printf '\n$ %s\n' "$*"
  "$@" 2>&1 || true
}

section "Session basics"
run bash -lc 'printf "XDG_CURRENT_DESKTOP=%s\n" "${XDG_CURRENT_DESKTOP-}"; printf "XDG_SESSION_TYPE=%s\n" "${XDG_SESSION_TYPE-}"; printf "WAYLAND_DISPLAY=%s\n" "${WAYLAND_DISPLAY-}"; printf "DISPLAY=%s\n" "${DISPLAY-}"'

section "Privilege escalation binaries"
run bash -lc 'command -v pkexec'
run bash -lc 'command -v kdesudo || true'
run bash -lc 'command -v sudo || true'

section "Installed polkit agent packages"
run bash -lc 'rpm -q polkit-gnome polkit-kde hyprpolkitagent lxqt-policykit mate-polkit 2>/dev/null || true'

section "Running polkit processes"
run bash -lc 'ps -ef | grep -Ei "polkitd|polkit.*agent|authentication-agent|hyprpolkitagent|polkit-kde|polkit-gnome|lxqt-policykit|mate-polkit" | grep -v grep || true'

section "Relevant binaries on disk"
run bash -lc 'ls -l /usr/lib/polkit-kde-authentication-agent-1 2>/dev/null || true'
run bash -lc 'ls -l /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 2>/dev/null || true'
run bash -lc 'ls -l /usr/lib/hyprpolkitagent/hyprpolkitagent 2>/dev/null || true'
run bash -lc 'ls -l /usr/bin/lxqt-policykit-agent 2>/dev/null || true'

section "systemd user services"
run bash -lc 'systemctl --user list-unit-files | grep -Ei "polkit|hyprpolkit" || true'
run bash -lc 'systemctl --user --no-pager --full status plasma-polkit-agent.service 2>/dev/null || true'
run bash -lc 'systemctl --user --no-pager --full status hyprpolkitagent.service 2>/dev/null || true'

section "Etcher launcher paths"
run bash -lc 'command -v balena-etcher || true'
run bash -lc 'ls -l ~/.local/bin/balena-etcher 2>/dev/null || true'
run bash -lc 'file ~/.local/bin/balena-etcher 2>/dev/null || true'
run bash -lc 'head -n 20 ~/.local/bin/balena-etcher 2>/dev/null || true'

section "Etcher desktop entries"
run bash -lc 'grep -RIl "balena-etcher|etcher" ~/.local/share/applications /usr/share/applications 2>/dev/null || true'
run bash -lc 'grep -RIn "^Exec=.*balena-etcher\|^Exec=.*etcher" ~/.local/share/applications /usr/share/applications 2>/dev/null || true'

section "Portal/auth environment"
run bash -lc 'systemctl --user show-environment | grep -E "^(DISPLAY|WAYLAND_DISPLAY|XDG_CURRENT_DESKTOP|XDG_SESSION_TYPE|XDG_MENU_PREFIX)=" | sort || true'
run bash -lc 'busctl --user list | grep -Ei "portal|polkit" || true'

section "Optional live launch test"
printf '%s\n' \
  'To capture a direct launch error manually, run in the Hyprland session:' \
  '  ~/.local/bin/balena-etcher 2>&1 | tee etcher-launch.log' \
  'If the app freezes when clicking Flash, also record whether any polkit prompt appears.'
